# SERVER ONLY. Never use a VITE_ prefix for secrets.
JOKO_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
JOKO_ASSISTANT_PROVIDER=openai
JOKO_ASSISTANT_MODEL=gpt-5.4-mini
JOKO_ASSISTANT_ALLOWED_MODELS=gpt-5.4-mini
# Positive price ceilings, USD / million tokens. Required for other providers/models.
JOKO_ASSISTANT_INPUT_USD_PER_MILLION=0.75
JOKO_ASSISTANT_OUTPUT_USD_PER_MILLION=4.5
# Required for OpenRouter: exact provider slugs from its model endpoint catalogue.
JOKO_ASSISTANT_OPENROUTER_PROVIDERS=
# Optional: 1..4. Defaults to 1 for Ollama Cloud, 4 otherwise.
JOKO_ASSISTANT_MAX_CONCURRENT=
PORT=3101
JOKO_ASSISTANT_ORIGINS=https://joko.today
JOKO_ASSISTANT_HOSTS=joko.today,localhost,127.0.0.1
JOKO_ASSISTANT_MCP_URL=http://127.0.0.1:3100/mcp
JOKO_ASSISTANT_MONTHLY_USD=10
JOKO_ASSISTANT_STATE_DIR=/var/lib/joko-assistant
# Provider/model selection is server-only; restart the service after changing it.
